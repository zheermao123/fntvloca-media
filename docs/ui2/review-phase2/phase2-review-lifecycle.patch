@@ -0,0 +1,96 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { usePrivacyState } from '../../app/PrivacyStateProvider';
+import { fetchHomeOverview } from '../../services/library/libraryService';
+import type { HomeOverview } from '../../services/library/library.types';
+import { ErrorState } from '../../components/ui/ErrorState';
+import { EmptyState } from '../../components/ui/EmptyState';
+import { LockIcon } from '../../components/icons';
+import { HomeHeader } from './HomeHeader';
+import { LibraryOverview, LibraryOverviewSkeleton } from './LibraryOverview';
+import { RecentlyAddedSection, RecentlyAddedSkeleton } from './RecentlyAddedSection';
+import { CategoryQuickLinks } from './CategoryQuickLinks';
+import { HomeEmptyState } from './HomeEmptyState';
+
+type LoadState =
+    | { status: 'loading' }
+    | { status: 'error'; message: string }
+    | { status: 'success'; data: HomeOverview };
+
+export function HomePage() {
+    const privacy = usePrivacyState();
+    const [state, setState] = useState<LoadState>({ status: 'loading' });
+    const requestSeqRef = useRef(0);
+
+    const load = useCallback(async () => {
+        const seq = ++requestSeqRef.current;
+        setState({ status: 'loading' });
+        try {
+            const data = await fetchHomeOverview();
+            if (requestSeqRef.current !== seq) {
+                return;
+            }
+            setState({ status: 'success', data });
+        } catch (error) {
+            if (requestSeqRef.current !== seq) {
+                return;
+            }
+            setState({ status: 'error', message: error instanceof Error ? error.message : '加载失败' });
+        }
+    }, []);
+
+    useEffect(() => {
+        if (privacy.active) {
+            return;
+        }
+        void load();
+    }, [load, privacy.active]);
+
+    if (privacy.active) {
+        return (
+            <section className="app-page">
+                <EmptyState
+                    icon={<LockIcon size={24} />}
+                    title="隐私模式中"
+                    description="首页不展示隐私媒体与统计。媒体库与详情页将在隐私模式下按可见性规则展示内容。"
+                />
+            </section>
+        );
+    }
+
+    if (state.status === 'loading') {
+        return (
+            <section className="app-page">
+                <HomeHeader />
+                <LibraryOverviewSkeleton />
+                <RecentlyAddedSkeleton />
+            </section>
+        );
+    }
+
+    if (state.status === 'error') {
+        return (
+            <section className="app-page">
+                <ErrorState title="媒体库加载失败" description={state.message} onRetry={() => void load()} />
+            </section>
+        );
+    }
+
+    const totalCount = state.data.categories.reduce((sum, category) => sum + category.count, 0);
+    if (totalCount === 0) {
+        return (
+            <section className="app-page">
+                <HomeHeader />
+                <HomeEmptyState />
+            </section>
+        );
+    }
+
+    return (
+        <section className="app-page">
+            <HomeHeader />
+            <CategoryQuickLinks />
+            <LibraryOverview categories={state.data.categories} />
+            <RecentlyAddedSection items={state.data.recent} />
+        </section>
+    );
+}
diff --git a/src/renderer/pages/library/LibraryPage.tsx b/src/renderer/pages/library/LibraryPage.tsx
new file mode 100644
index 0000000..3bd1de9
--- /dev/null
+++ b/src/renderer/pages/library/LibraryPage.tsx
@@ -0,0 +1,108 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { Navigate, useParams } from 'react-router-dom';
+import { usePrivacyState } from '../../app/PrivacyStateProvider';
+import { CATEGORY_META, resolveCategoryFromSegment } from '../../app/routes';
+import { queryCatalog } from '../../services/library/libraryService';
+import { mapCatalogEntries } from '../../services/library/library.mapper';
+import type { CatalogEntryDto, MediaCardModel } from '../../services/library/library.types';
+import { LibraryPageHeader } from './LibraryPageHeader';
+import { LibraryToolbar } from './LibraryToolbar';
+import { MediaGrid } from './MediaGrid';
+import { MediaListView } from './MediaListView';
+import { LibraryLoadingState } from './LibraryLoadingState';
+import { LibraryEmptyState } from './LibraryEmptyState';
+import { LibraryErrorState } from './LibraryErrorState';
+import { mapLibraryRows } from './library.mapper';
+import type { FavoriteFilterKey, SortKey, ViewMode, WatchedFilterKey } from './library.types';
+
+const QUERY_LIMIT = 600;
+
+type LoadState =
+    | { status: 'loading' }
+    | { status: 'error'; message: string }
+    | { status: 'success'; entries: CatalogEntryDto[] };
+
+export function LibraryPage() {
+    const { category: segment } = useParams();
+    const category = resolveCategoryFromSegment(segment);
+    const privacy = usePrivacyState();
+
+    const [sort, setSort] = useState<SortKey>('added');
+    const [watched, setWatched] = useState<WatchedFilterKey>('all');
+    const [favorite, setFavorite] = useState<FavoriteFilterKey>('all');
+    const [view, setView] = useState<ViewMode>('grid');
+    const [state, setState] = useState<LoadState>({ status: 'loading' });
+    const requestSeqRef = useRef(0);
+
+    const load = useCallback(async () => {
+        if (!category) {
+            return;
+        }
+        const seq = ++requestSeqRef.current;
+        setState({ status: 'loading' });
+        try {
+            const entries = await queryCatalog({
+                category,
+                sort,
+                watched: watched === 'all' ? undefined : watched === 'watched',
+                favorite: favorite === 'all' ? undefined : favorite === 'fav',
+                limit: QUERY_LIMIT,
+                private: privacy.active,
+            });
+            if (requestSeqRef.current !== seq) {
+                return;
+            }
+            setState({ status: 'success', entries });
+        } catch (error) {
+            if (requestSeqRef.current !== seq) {
+                return;
+            }
+            setState({ status: 'error', message: error instanceof Error ? error.message : '加载失败' });
+        }
+    }, [category, sort, watched, favorite, privacy.active]);
+
+    useEffect(() => {
+        void load();
+    }, [load]);
+
+    if (!category) {
+        return <Navigate to="/home" replace />;
+    }
+
+    const cards: MediaCardModel[] = useMemo(
+        () => (state.status === 'success' ? mapCatalogEntries(state.entries) : []),
+        [state]
+    );
+    const rows = useMemo(
+        () => (state.status === 'success' ? mapLibraryRows(state.entries) : []),
+        [state]
+    );
+    const count = state.status === 'success' ? state.entries.length : 0;
+    const title = privacy.active ? '隐私库' : CATEGORY_META[category].label;
+
+    return (
+        <section className="app-page" aria-label={title}>
+            <LibraryPageHeader title={title} count={count} capped={count >= QUERY_LIMIT} />
+            <LibraryToolbar
+                sort={sort}
+                watched={watched}
+                favorite={favorite}
+                view={view}
+                onSortChange={setSort}
+                onWatchedChange={setWatched}
+                onFavoriteChange={setFavorite}
+                onViewChange={setView}
+            />
+            {state.status === 'loading' ? <LibraryLoadingState /> : null}
+            {state.status === 'error' ? <LibraryErrorState message={state.message} onRetry={() => void load()} /> : null}
+            {state.status === 'success' && state.entries.length === 0 ? (
+                <LibraryEmptyState privacy={privacy.active} />
+            ) : null}
+            {state.status === 'success' && state.entries.length > 0
+                ? view === 'grid'
+                    ? <MediaGrid cards={cards} />
+                    : <MediaListView rows={rows} />
+                : null}
+        </section>
+    );
+}
diff --git a/src/renderer/pages/search/SearchPanel.tsx b/src/renderer/pages/search/SearchPanel.tsx
new file mode 100644
index 0000000..e2e5105
--- /dev/null
+++ b/src/renderer/pages/search/SearchPanel.tsx
@@ -0,0 +1,104 @@
+import { useEffect, useState } from 'react';
+import { usePrivacyState } from '../../app/PrivacyStateProvider';
+import { Input } from '../../components/ui/Input';
+import { EmptyState } from '../../components/ui/EmptyState';
+import { ErrorState } from '../../components/ui/ErrorState';
+import { Skeleton } from '../../components/ui/Skeleton';
+import { SearchIcon } from '../../components/icons';
+import { MediaCard } from '../../components/media/MediaCard';
+import { queryCatalog } from '../../services/library/libraryService';
+import { mapCatalogEntries } from '../../services/library/library.mapper';
+import type { MediaCardModel } from '../../services/library/library.types';
+
+const SEARCH_LIMIT = 50;
+const DEBOUNCE_MS = 300;
+
+type SearchState =
+    | { status: 'idle' }
+    | { status: 'loading' }
+    | { status: 'error'; message: string }
+    | { status: 'success'; cards: MediaCardModel[] };
+
+export function SearchPanel({ onNavigate }: { onNavigate: () => void }) {
+    const privacy = usePrivacyState();
+    const [query, setQuery] = useState('');
+    const [state, setState] = useState<SearchState>({ status: 'idle' });
+
+    useEffect(() => {
+        const keyword = query.trim();
+        if (!keyword) {
+            setState({ status: 'idle' });
+            return;
+        }
+        let cancelled = false;
+        setState({ status: 'loading' });
+        const timer = window.setTimeout(() => {
+            queryCatalog({ query: keyword, limit: SEARCH_LIMIT, private: privacy.active })
+                .then((entries) => {
+                    if (!cancelled) {
+                        setState({ status: 'success', cards: mapCatalogEntries(entries) });
+                    }
+                })
+                .catch((error: unknown) => {
+                    if (!cancelled) {
+                        setState({ status: 'error', message: error instanceof Error ? error.message : '搜索失败' });
+                    }
+                });
+        }, DEBOUNCE_MS);
+        return () => {
+            cancelled = true;
+            window.clearTimeout(timer);
+        };
+    }, [query, privacy.active]);
+
+    return (
+        <div className="search-panel">
+            <Input
+                label="搜索"
+                placeholder="搜索电影、剧集、动漫标题"
+                value={query}
+                onChange={(event) => setQuery(event.target.value)}
+                data-autofocus
+            />
+            <p className="search-panel__hint">按标题搜索（含剧集名），不支持按文件名搜索；结果最多 {SEARCH_LIMIT} 条。</p>
+            {state.status === 'idle' ? (
+                <EmptyState
+                    icon={<SearchIcon size={22} />}
+                    title="输入关键词开始搜索"
+                    description="搜索会直接查询本地媒体库目录，输入即搜（300ms 防抖）。"
+                />
+            ) : null}
+            {state.status === 'loading' ? (
+                <div className="search-panel__results" aria-hidden="true">
+                    <Skeleton variant="text" />
+                    <Skeleton variant="text" />
+                    <Skeleton variant="text" />
+                </div>
+            ) : null}
+            {state.status === 'error' ? (
+                <ErrorState title="搜索失败" description={state.message} onRetry={() => setQuery((value) => `${value} `)} />
+            ) : null}
+            {state.status === 'success' && state.cards.length === 0 ? (
+                <EmptyState
+                    icon={<SearchIcon size={22} />}
+                    title="未找到匹配内容"
+                    description="试试更短的关键词，或确认媒体库已完成扫描与收录。"
+                />
+            ) : null}
+            {state.status === 'success' && state.cards.length > 0 ? (
+                <div
+                    className="media-grid search-panel__results"
+                    onClick={(event) => {
+                        if (event.target instanceof Element && event.target.closest('a')) {
+                            onNavigate();
+                        }
+                    }}
+                >
+                    {state.cards.map((card) => (
+                        <MediaCard key={card.key} model={card} />
+                    ))}
+                </div>
+            ) : null}
+        </div>
+    );
+}
diff --git a/src/renderer/pages/sources/SourcesPage.tsx b/src/renderer/pages/sources/SourcesPage.tsx
