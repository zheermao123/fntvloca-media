+import { useEffect, useMemo, useRef, useState } from 'react';
+import { Outlet, useLocation, useNavigate } from 'react-router-dom';
+import { WindowFrame } from '../layout/WindowFrame';
+import { Sidebar } from '../layout/Sidebar';
+import { MainRegion } from '../layout/MainRegion';
+import { PageHeader } from '../layout/PageHeader';
+import { Dialog } from '../components/ui/Dialog';
+import { SearchPanel } from '../pages/search/SearchPanel';
+import { usePrivacyState } from './PrivacyStateProvider';
+import { CATEGORY_META, ROUTES, resolveCategoryFromSegment } from './routes';
+
+function titleForPath(pathname: string): string {
+    if (pathname === '/home' || pathname === '/') {
+        return '首页';
+    }
+    if (pathname.startsWith('/library/')) {
+        const segment = pathname.split('/')[2];
+        const category = resolveCategoryFromSegment(segment);
+        return category ? CATEGORY_META[category].label : '媒体库';
+    }
+    if (pathname.startsWith('/media/')) {
+        return '媒体详情';
+    }
+    if (pathname === '/sources') {
+        return '媒体源';
+    }
+    if (pathname === '/tasks') {
+        return '任务状态';
+    }
+    return '媒体库';
+}
+
+export function AppShell() {
+    const location = useLocation();
+    const navigate = useNavigate();
+    const privacy = usePrivacyState();
+    const [searchOpen, setSearchOpen] = useState(false);
+    const title = useMemo(() => titleForPath(location.pathname), [location.pathname]);
+    const prevPrivacyActive = useRef(privacy.active);
+
+    useEffect(() => {
+        if (prevPrivacyActive.current && !privacy.active) {
+            setSearchOpen(false);
+            navigate(ROUTES.home, { replace: true });
+        }
+        prevPrivacyActive.current = privacy.active;
+    }, [privacy.active, navigate]);
+
+    useEffect(() => {
+        const onKeyDown = (event: KeyboardEvent) => {
+            if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
+                event.preventDefault();
+                setSearchOpen(true);
+            }
+        };
+        window.addEventListener('keydown', onKeyDown);
+        return () => window.removeEventListener('keydown', onKeyDown);
+    }, []);
+
+    return (
+        <div className="app-shell-root">
+            <WindowFrame>
+                <Sidebar />
+                <MainRegion>
+                    <PageHeader title={title} onSearchOpen={() => setSearchOpen(true)} />
+                    <div className="app-main__scroll">
+                        <Outlet />
+                    </div>
+                </MainRegion>
+            </WindowFrame>
+            <Dialog open={searchOpen} title="全局搜索" onClose={() => setSearchOpen(false)}>
+                <SearchPanel onNavigate={() => setSearchOpen(false)} />
+            </Dialog>
+        </div>
+    );
+}
diff --git a/src/renderer/app/PrivacyStateProvider.tsx b/src/renderer/app/PrivacyStateProvider.tsx
new file mode 100644
index 0000000..3e928c4
--- /dev/null
+++ b/src/renderer/app/PrivacyStateProvider.tsx
@@ -0,0 +1,195 @@
+import { createContext, useCallback, useContext, useEffect, useMemo, useState } from 'react';
+import type { ReactNode } from 'react';
+import { onceReply, sendChannel } from './bridge';
+import { Dialog } from '../components/ui/Dialog';
+import { Input } from '../components/ui/Input';
+import { Button } from '../components/ui/Button';
+
+type PrivacyState = {
+    available: boolean;
+    hasPassword: boolean;
+    unlocked: boolean;
+};
+
+type PrivacyContextValue = PrivacyState & {
+    /** 是否处于隐私模式（UI 层状态，与 main 解锁态联动） */
+    active: boolean;
+    gateOpen: boolean;
+    busy: boolean;
+    error: string | null;
+    requestActivate: () => void;
+    closeGate: () => void;
+    submitPassword: (password: string) => Promise<void>;
+    deactivate: () => Promise<void>;
+};
+
+const PrivacyContext = createContext<PrivacyContextValue | null>(null);
+
+export function PrivacyStateProvider({ children }: { children: ReactNode }) {
+    const [state, setState] = useState<PrivacyState>({ available: false, hasPassword: false, unlocked: false });
+    const [active, setActive] = useState(false);
+    const [gateOpen, setGateOpen] = useState(false);
+    const [busy, setBusy] = useState(false);
+    const [error, setError] = useState<string | null>(null);
+    const [password, setPassword] = useState('');
+
+    const refresh = useCallback(async () => {
+        if (!sendChannel('library:privacy-begin')) {
+            return;
+        }
+        try {
+            const data = await onceReply<{ hasPassword?: boolean; unlocked?: boolean }>('library:privacy-state');
+            setState({
+                available: true,
+                hasPassword: data?.hasPassword === true,
+                unlocked: data?.unlocked === true,
+            });
+            if (data?.unlocked !== true) {
+                setActive(false);
+            }
+        } catch {
+            setState({ available: false, hasPassword: false, unlocked: false });
+        }
+    }, []);
+
+    useEffect(() => {
+        void refresh();
+    }, [refresh]);
+
+    const requestActivate = useCallback(() => {
+        if (!state.available) {
+            return;
+        }
+        setError(null);
+        setPassword('');
+        if (state.unlocked) {
+            setActive(true);
+            return;
+        }
+        setGateOpen(true);
+    }, [state.available, state.unlocked]);
+
+    const closeGate = useCallback(() => {
+        setGateOpen(false);
+        setError(null);
+        setPassword('');
+    }, []);
+
+    const submitPassword = useCallback(
+        async (value: string) => {
+            if (!state.available || busy) {
+                return;
+            }
+            setBusy(true);
+            setError(null);
+            try {
+                if (!sendChannel('library:privacy-unlock', { password: value })) {
+                    setError('桌面桥接不可用');
+                    return;
+                }
+                const result = await onceReply<{ success?: boolean; unlocked?: boolean; error?: string }>('library:privacy-result');
+                if (result?.success && result.unlocked) {
+                    setState((prev) => ({ ...prev, unlocked: true }));
+                    setGateOpen(false);
+                    setPassword('');
+                    setActive(true);
+                } else {
+                    setError(result?.error || '解锁失败');
+                }
+            } catch {
+                setError('解锁请求超时');
+            } finally {
+                setBusy(false);
+            }
+        },
+        [state.available, busy]
+    );
+
+    const deactivate = useCallback(async () => {
+        if (busy) {
+            return;
+        }
+        setBusy(true);
+        try {
+            if (sendChannel('library:privacy-lock')) {
+                try {
+                    await onceReply('library:privacy-result');
+                } catch {
+                    // 忽略超时；本地状态仍然退出隐私模式
+                }
+            }
+        } finally {
+            setActive(false);
+            setState((prev) => ({ ...prev, unlocked: false }));
+            setBusy(false);
+        }
+    }, [busy]);
+
+    const value = useMemo<PrivacyContextValue>(
+        () => ({
+            ...state,
+            active,
+            gateOpen,
+            busy,
+            error,
+            requestActivate,
+            closeGate,
+            submitPassword,
+            deactivate,
+        }),
+        [state, active, gateOpen, busy, error, requestActivate, closeGate, submitPassword, deactivate]
+    );
+
+    return (
+        <PrivacyContext.Provider value={value}>
+            {children}
+            <Dialog
+                open={gateOpen}
+                title={state.hasPassword ? '进入隐私模式' : '隐私模式未设置密码'}
+                onClose={closeGate}
+                footer={
+                    <>
+                        <Button variant="ghost" onClick={closeGate}>
+                            取消
+                        </Button>
+                        <Button
+                            variant="primary"
+                            loading={busy}
+                            disabled={!state.hasPassword || password.length === 0}
+                            onClick={() => void submitPassword(password)}
+                        >
+                            解锁
+                        </Button>
+                    </>
+                }
+            >
+                {state.hasPassword ? (
+                    <Input
+                        label="密码"
+                        type="password"
+                        autoComplete="current-password"
+                        data-autofocus
+                        value={password}
+                        error={error ?? undefined}
+                        onChange={(event) => setPassword(event.target.value)}
+                        onKeyDown={(event) => {
+                            if (event.key === 'Enter') {
+                                void submitPassword(password);
+                            }
+                        }}
+                    />
+                ) : (
+                    <p>尚未设置隐私密码，请先在设置中创建隐私密码后再进入。</p>
+                )}
+            </Dialog>
+        </PrivacyContext.Provider>
+    );
+}
+
+export function usePrivacyState(): PrivacyContextValue {
+    const value = useContext(PrivacyContext);
+    if (!value) {
+        throw new Error('usePrivacyState 必须在 PrivacyStateProvider 内使用');
+    }
+    return value;
+}
diff --git a/src/renderer/app/bridge.ts b/src/renderer/app/bridge.ts
new file mode 100644
index 0000000..07da003
--- /dev/null
+++ b/src/renderer/app/bridge.ts
@@ -0,0 +1,68 @@
+/** 渲染层对 preload 桥接的薄封装（P2-07 将归入 services/desktop） */
+
+export function getBridge() {
+    return window.electronAPI;
+}
+
+export function sendChannel(channel: string, payload?: unknown): boolean {
+    const bridge = getBridge();
+    if (!bridge) {
+        return false;
+    }
+    bridge.send(channel, payload);
+    return true;
+}
+
+export type CancellableReply<T> = {
+    promise: Promise<T>;
+    cancel: () => void;
+};
+
+/** 可取消的一次性回复监听（用于未挂载/离开页面时释放长等待监听） */
+export function onceReplyCancellable<T>(channel: string, timeoutMs = 5000): CancellableReply<T> {
+    const bridge = getBridge();
+    if (!bridge) {
+        const promise = Promise.reject<T>(new Error('BRIDGE_UNAVAILABLE'));
+        promise.catch(() => undefined);
+        return { promise, cancel: () => undefined };
+    }
+    let settled = false;
+    let timer = 0;
+    let resolveFn!: (value: T) => void;
+    let rejectFn!: (error: Error) => void;
+    const listener = (_event: unknown, data: unknown) => {
+        if (settled) {
+            return;
+        }
+        settled = true;
+        window.clearTimeout(timer);
+        resolveFn(data as T);
+    };
+    const promise = new Promise<T>((resolve, reject) => {
+        resolveFn = resolve;
+        rejectFn = reject;
+        timer = window.setTimeout(() => {
+            if (settled) {
+                return;
+            }
+            settled = true;
+            bridge.off?.(channel, listener);
+            reject(new Error('IPC_TIMEOUT'));
+        }, timeoutMs);
+        bridge.once(channel, listener);
+    });
+    const cancel = () => {
+        if (settled) {
+            return;
+        }
+        settled = true;
+        window.clearTimeout(timer);
+        bridge.off?.(channel, listener);
+        rejectFn(new Error('IPC_CANCELLED'));
+    };
+    return { promise, cancel };
+}
+
+export function onceReply<T>(channel: string, timeoutMs = 5000): Promise<T> {
+    return onceReplyCancellable<T>(channel, timeoutMs).promise;
+}
