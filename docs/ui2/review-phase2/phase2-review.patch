+    font-size: var(--font-size-md);
+    text-align: left;
+}
+.ui-dropdown__item:hover:not(:disabled),
+.ui-dropdown__item--active:not(:disabled) { background: var(--color-surface-muted); }
+.ui-dropdown__item:disabled { opacity: 0.4; cursor: default; }
+.ui-dropdown__item--danger { color: var(--color-danger); }
+.ui-dropdown__item-icon { display: inline-flex; color: var(--color-text-secondary); }
+
+/* ---------- Tooltip ---------- */
+.ui-tooltip { position: relative; display: inline-flex; }
+.ui-tooltip::after {
+    content: attr(data-tooltip);
+    position: absolute;
+    bottom: calc(100% + 6px);
+    left: 50%;
+    transform: translateX(-50%);
+    z-index: var(--z-tooltip);
+    padding: var(--space-1) var(--space-2);
+    border-radius: var(--radius-sm);
+    background: var(--color-text-primary);
+    color: var(--color-surface);
+    font-size: var(--font-size-xs);
+    white-space: nowrap;
+    opacity: 0;
+    pointer-events: none;
+    transition: opacity var(--duration-fast) var(--easing-standard);
+}
+.ui-tooltip:hover::after,
+.ui-tooltip:focus-within::after { opacity: 1; }
+
+/* ---------- Skeleton ---------- */
+.ui-skeleton {
+    display: block;
+    border-radius: var(--radius-md);
+    background: linear-gradient(
+        90deg,
+        var(--color-surface-muted) 25%,
+        var(--color-surface-hover) 37%,
+        var(--color-surface-muted) 63%
+    );
+    background-size: 400% 100%;
+    animation: ui-skeleton-shimmer 1.4s ease infinite;
+}
+.ui-skeleton--text { height: 12px; border-radius: var(--radius-sm); }
+.ui-skeleton--rect { height: 120px; }
+.ui-skeleton--circle { width: 40px; height: 40px; border-radius: var(--radius-pill); }
+
+@keyframes ui-skeleton-shimmer {
+    0% { background-position: 100% 50%; }
+    100% { background-position: 0 50%; }
+}
+
+/* ---------- EmptyState / ErrorState ---------- */
+.ui-empty-state,
+.ui-error-state {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: var(--space-2);
+    padding: var(--space-10) var(--space-6);
+    color: var(--color-text-secondary);
+    text-align: center;
+}
+.ui-empty-state__icon { color: var(--color-text-tertiary); }
+.ui-empty-state__title,
+.ui-error-state__title { font-size: var(--font-size-lg); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); }
+.ui-empty-state__description,
+.ui-error-state__description { font-size: var(--font-size-md); max-width: 420px; }
+.ui-empty-state__action { margin-top: var(--space-2); }
+
+/* ---------- Poster ---------- */
+.ui-poster {
+    position: relative;
+    aspect-ratio: 2 / 3;
+    overflow: hidden;
+    border-radius: var(--radius-lg);
+    background: var(--color-surface-muted);
+}
+.ui-poster__image { width: 100%; height: 100%; object-fit: cover; }
+.ui-poster__placeholder {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 100%;
+    height: 100%;
+    color: var(--color-text-tertiary);
+    background: var(--color-surface-muted);
+}
